# better-mac hotkey layer (starter) — cmd+alt combos to avoid shadowing
# in-app shortcuts. Reloads automatically on every `make switch`.

# launch apps — per-app choice: -a activates the running instance (Arc is
# single-instance and errors on -n); -na lets multi-window apps spawn anew.
# Each chord lands you in the app's home workspace (W1 zed and ghostty,
# W2 browser, W3 chats); omniwmctl needs the absolute path under launchd.
cmd + alt - z : open -na Zed; /opt/homebrew/bin/omniwmctl command switch-workspace 1
cmd + alt - b : open -a Arc; /opt/homebrew/bin/omniwmctl command switch-workspace 2
cmd + alt - t : open -na Ghostty; /opt/homebrew/bin/omniwmctl command switch-workspace 1
cmd + alt - s : open -a Slack; /opt/homebrew/bin/omniwmctl command switch-workspace 3
cmd + alt - m : open -a Telegram; /opt/homebrew/bin/omniwmctl command switch-workspace 3
cmd + alt - w : open -a WhatsApp; /opt/homebrew/bin/omniwmctl command switch-workspace 3

cmd + alt + shift - left  : workspace=$(/opt/homebrew/bin/omniwmctl query active-workspace --format json | /usr/bin/jq -r '.result.payload.workspace.rawName // empty'); test -z "$workspace" || /opt/homebrew/bin/omniwmctl workspace move-to-monitor "$workspace" left --force
cmd + alt + shift - right : workspace=$(/opt/homebrew/bin/omniwmctl query active-workspace --format json | /usr/bin/jq -r '.result.payload.workspace.rawName // empty'); test -z "$workspace" || /opt/homebrew/bin/omniwmctl workspace move-to-monitor "$workspace" right --force
cmd + alt + shift - up    : workspace=$(/opt/homebrew/bin/omniwmctl query active-workspace --format json | /usr/bin/jq -r '.result.payload.workspace.rawName // empty'); test -z "$workspace" || /opt/homebrew/bin/omniwmctl workspace move-to-monitor "$workspace" up --force
cmd + alt + shift - down  : workspace=$(/opt/homebrew/bin/omniwmctl query active-workspace --format json | /usr/bin/jq -r '.result.payload.workspace.rawName // empty'); test -z "$workspace" || /opt/homebrew/bin/omniwmctl workspace move-to-monitor "$workspace" down --force
