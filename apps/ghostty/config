# Ghostty. Deployed to ~/.config/ghostty/config by home-manager; the old
# Application Support copy was retired when this file took over.

font-family = Hack Nerd Font Mono
font-family = FiraCode Nerd Font Mono
font-family-bold = Hack Nerd Font Mono Bold
font-family-bold = FiraCode Nerd Font Mono Bold
font-family-bold-italic = Hack Nerd Font Mono Bold Italic
font-family-italic = Hack Nerd Font Mono Italic
font-size = 20

# Keep the terminal palette aligned with the Zed "One Dark" / "One Light" pair.
theme = light:Atom One Light,dark:Atom One Dark

# Translucent window with a blurred backdrop.
background-opacity = 0.58
background-blur = 20
background-opacity-cells = true

window-padding-x = 10
window-padding-y = 8
window-padding-balance = true
window-padding-color = background

adjust-cell-height = 10%
font-thicken = true

cursor-style = block
cursor-style-blink = false

mouse-hide-while-typing = true
copy-on-select = clipboard
clipboard-read = allow
clipboard-write = allow

unfocused-split-opacity = 0.7
unfocused-split-fill = #21252b
split-divider-color = #3b4048

minimum-contrast = 1.1
scrollback-limit = 100000
window-save-state = always
confirm-close-surface = false
window-colorspace = display-p3
macos-titlebar-style = tabs

shell-integration = detect
shell-integration-features = cursor,sudo,title

bell-features = system,audio,border
notify-on-command-finish = unfocused
notify-on-command-finish-action = bell,no-notify
notify-on-command-finish-after = 5s
quick-terminal-position = center
macos-option-as-alt = true

keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+alt+left=goto_split:left
keybind = super+alt+right=goto_split:right
keybind = super+alt+up=goto_split:top
keybind = super+alt+down=goto_split:bottom
keybind = super+shift+enter=toggle_split_zoom
keybind = super+shift+f=toggle_fullscreen

# Pi binds alt+backspace; emit the legacy ESC-DEL form it accepts.
keybind = alt+backspace=text:\x1b\x7f
